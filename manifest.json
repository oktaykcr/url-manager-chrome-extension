{
  "manifest_version": 3,
  "name": "URL Manager",
  "version": "1.2",
  "description": "A Chrome extension to save and manage web URLs",
  "permissions": [
    "storage",
    "tabs",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "webRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "declarative_net_request": {
    "rule_resources": []
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["quick-search.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
} 